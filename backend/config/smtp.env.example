# Từ thư mục backend, sao chép config/smtp.env.example thành smtp.env và điền thông tin nhà cung cấp email.
# Chạy bằng Node: node --env-file=smtp.env server.cjs
# Giữ smtp.env ở ngoài thư mục public. Mẫu này chứa các giá trị trống.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Địa chỉ website khách truy cập, ví dụ https://cuahang.example
SHOP_PUBLIC_URL=
